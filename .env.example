# Copier ce fichier en ".env" pour un test local. Ne JAMAIS committer le ".env" réel.
# En production, ces valeurs sont des GitHub Secrets (Settings > Secrets and variables > Actions),
# pas des fichiers .env.

# Choix du fournisseur LLM : groq | gemini | anthropic
LLM_PROVIDER=groq

# Une seule des clés ci-dessous est nécessaire, selon LLM_PROVIDER choisi.
GROQ_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
